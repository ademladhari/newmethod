_IMG_EXTS = {".jpg", ".jpeg", ".png", ".webp", ".bmp"}
PATCH = 128


def list_images(root: Path, n: int) -> list[Path]:
    paths = sorted(p for p in root.iterdir() if p.is_file() and p.suffix.lower() in _IMG_EXTS)
    if len(paths) < n:
        raise FileNotFoundError(f"Need {n} images in {root}, found {len(paths)}")
    return paths[:n]


def load_rgb_patch(path: Path, size: int = PATCH) -> Image.Image:
    with Image.open(path) as im:
        im = im.convert("RGB")
        w, h = im.size
        s = min(w, h)
        l, t = (w - s) // 2, (h - s) // 2
        return im.crop((l, t, l + s, t + s)).resize((size, size), Image.Resampling.LANCZOS).copy()


def pil_to_tensor(im: Image.Image, device: torch.device) -> torch.Tensor:
    arr = np.asarray(im, dtype=np.float32) / 255.0
    t = torch.from_numpy(arr).permute(2, 0, 1).unsqueeze(0).to(device)
    return t * 2.0 - 1.0


def tensor_to_pil(t: torch.Tensor) -> Image.Image:
    arr = (
        (t.squeeze(0).clamp(-1, 1).detach().cpu().permute(1, 2, 0).numpy() + 1.0) * 127.5
    ).astype(np.uint8)
    return Image.fromarray(arr, "RGB")


def hidden_noise_registry(device: torch.device) -> dict[str, list]:
    """Same attack strengths as scripts/compare_hidden_vs_moe_attacks.py."""
    from noise_layers.crop import Crop  # noqa: E402
    from noise_layers.cropout import Cropout  # noqa: E402
    from noise_layers.dropout import Dropout  # noqa: E402
    from noise_layers.identity import Identity  # noqa: E402
    from noise_layers.jpeg_compression import JpegCompression  # noqa: E402
    from noise_layers.quantization import Quantization  # noqa: E402
    from noise_layers.resize import Resize  # noqa: E402
    from moe.moe_noise import GaussianNoise  # noqa: E402

    return {
        "identity": [Identity()],
        "jpeg": [JpegCompression(device)],
        "quant": [Quantization(device)],
        "crop": [Crop((0.55, 0.6), (0.55, 0.6))],
        "cropout": [Cropout((0.55, 0.6), (0.55, 0.6))],
        "dropout": [Dropout((0.55, 0.6))],
        "resize": [Resize((0.5, 1.1))],
        "gaussian": [GaussianNoise((0.01, 0.05))],
        "combined": [
            Resize((0.5, 1.1)),
            JpegCompression(device),
            Crop((0.55, 0.6), (0.55, 0.6)),
            Dropout((0.55, 0.6)),
            GaussianNoise((0.01, 0.05)),
        ],
    }


def apply_hidden_attack(layers: list, encoded: torch.Tensor, cover: torch.Tensor) -> torch.Tensor:
    """Tensor-space attacks (matches compare_hidden_vs_moe_attacks.apply_attack)."""
    target_hw = (cover.shape[2], cover.shape[3])
    data = [encoded, cover]
    for layer in layers:
        layer.eval()
        data = layer(data)
        if data[0].shape[2:] != target_hw:
            data[0] = F.interpolate(data[0], size=target_hw, mode="bilinear", align_corners=False)
        data[1] = cover
    return data[0]


def psnr_pil(orig: Image.Image, attacked: Image.Image) -> float:
    a = np.asarray(orig, dtype=np.float32)
    b = np.asarray(attacked.resize(orig.size, Image.Resampling.LANCZOS), dtype=np.float32)
    mse = float(np.mean((a - b) ** 2))
    if mse < 1e-10:
        return 100.0
    return float(10.0 * np.log10(255.0 ** 2 / mse))


def load_hidden(ckpt: Path, run: Path, device: torch.device):
    import compare_hidden_vs_moe_watermark as cmp

    model, cfg, _ = cmp.load_hidden_baseline(ckpt, run / "options-and-config.pickle", device)
    return model, cfg


def load_moe(ckpt: Path, run: Path, device: torch.device):
    import compare_hidden_vs_moe_watermark as cmp

    return cmp.load_moe_model(run, ckpt, device, soft_router=True)


@torch.no_grad()
def encode(model, img_t: torch.Tensor, msg: torch.Tensor) -> torch.Tensor:
    return model.encoder_decoder.encoder(img_t, msg)


@torch.no_grad()
def decode_hidden(model, img_t: torch.Tensor) -> torch.Tensor:
    """HiDDeN: raw decoder output, round directly (no sigmoid)."""
    return model.encoder_decoder.decoder(img_t)


@torch.no_grad()
def decode_moe(model, img_t: torch.Tensor) -> torch.Tensor:
    logits, _, _, _ = model.encoder_decoder.decoder(img_t)
    return torch.sigmoid(logits)


def bits_from_output(out: torch.Tensor, *, use_sigmoid: bool) -> np.ndarray:
    if use_sigmoid:
        out = torch.sigmoid(out)
    return out.detach().cpu().numpy().flatten().round().clip(0, 1).astype(np.uint8)


def bit_acc(ref: np.ndarray, pred: np.ndarray) -> float:
    n = min(ref.size, pred.size)
    return float(np.mean(ref[:n] == pred[:n]))


def detection_score(prob: torch.Tensor, ref_bits: np.ndarray, *, use_sigmoid: bool) -> float:
    bits = bits_from_output(prob, use_sigmoid=use_sigmoid).astype(np.float32)
    ref = ref_bits[: bits.size].astype(np.float32)
    rho = float(np.mean((bits - 0.5) * (ref - 0.5)) * 4.0)
    return float(np.clip((rho + 1.0) * 0.5, 0.0, 1.0))


def auroc_tpr(pos: np.ndarray, neg: np.ndarray, fpr_target: float = 0.01) -> tuple[float, float]:
    y_true = np.concatenate([np.zeros(neg.size, dtype=np.int32), np.ones(pos.size, dtype=np.int32)])
    y_score = np.concatenate([neg, pos])
    auroc = float(sk_metrics.roc_auc_score(y_true, y_score))
    fpr, tpr, _ = sk_metrics.roc_curve(y_true, y_score, pos_label=1)
    below = np.where(fpr <= fpr_target)[0]
    tpr1 = float(tpr[below[-1]]) if below.size else float(tpr[0])
    return auroc, tpr1


def benchmark_model_waves(
    name: str,
    model,
    decode_fn,
    *,
    use_sigmoid: bool,
    images: list[Path],
    device: torch.device,
    msg_len: int,
) -> list[dict]:
    rng = np.random.default_rng(42)
    ref_bits = rng.integers(0, 2, msg_len, dtype=np.uint8)
    msg_t = torch.from_numpy(ref_bits.astype(np.float32)).unsqueeze(0).to(device)

    records: list[dict] = []
    print(f"\n[{name}] Embedding {len(images)} images …", flush=True)
    for path in tqdm(images, desc=f"{name}/embed", unit="img"):
        host_pil = load_rgb_patch(path)
        host_t = pil_to_tensor(host_pil, device)
        wm_t = encode(model, host_t, msg_t)
        records.append({"host_pil": host_pil, "wm_pil": tensor_to_pil(wm_t), "host_t": host_t, "wm_t": wm_t})

    neg_scores = np.asarray(
        [
            detection_score(decode_fn(model, r["host_t"]), ref_bits, use_sigmoid=use_sigmoid)
            for r in tqdm(records, desc=f"{name}/neg")
        ],
        dtype=np.float64,
    )

    rows: list[dict] = []
    for spec in WAVES_ATTACKS:
        psnr_vals, bit_vals, pos_scores = [], [], []
        for i, rec in enumerate(tqdm(records, desc=f"{name}/{spec.name}", unit="img", leave=False)):
            attacked_pil = apply_attack_rgb(spec.name, rec["wm_pil"], seed=i)
            psnr_vals.append(psnr_pil(rec["host_pil"], attacked_pil))
            arr = np.asarray(attacked_pil, dtype=np.float32) / 255.0
            atk_t = torch.from_numpy(arr).permute(2, 0, 1).unsqueeze(0).to(device) * 2.0 - 1.0
            out = decode_fn(model, atk_t)
            bit_vals.append(bit_acc(ref_bits, bits_from_output(out, use_sigmoid=use_sigmoid)))
            pos_scores.append(detection_score(out, ref_bits, use_sigmoid=use_sigmoid))

        rows.append(_attack_row(name, spec, len(records), psnr_vals, bit_vals, pos_scores, neg_scores))
    return rows


def benchmark_model_hidden(
    name: str,
    model,
    decode_fn,
    *,
    use_sigmoid: bool,
    images: list[Path],
    device: torch.device,
    msg_len: int,
    noise_registry: dict[str, list],
) -> list[dict]:
    records: list[dict] = []
    print(f"\n[{name}] Embedding {len(images)} images …", flush=True)
    for i, path in enumerate(tqdm(images, desc=f"{name}/embed", unit="img")):
        host_pil = load_rgb_patch(path)
        host_t = pil_to_tensor(host_pil, device)
        rng = np.random.default_rng(42 + i)
        ref_bits = rng.integers(0, 2, msg_len, dtype=np.uint8)
        msg_t = torch.from_numpy(ref_bits.astype(np.float32)).unsqueeze(0).to(device)
        wm_t = encode(model, host_t, msg_t)
        records.append(
            {
                "host_pil": host_pil,
                "host_t": host_t,
                "wm_t": wm_t,
                "wm_pil": tensor_to_pil(wm_t),
                "ref_bits": ref_bits,
            }
        )

    neg_scores = np.asarray(
        [
            detection_score(
                decode_fn(model, r["host_t"]),
                r["ref_bits"],
                use_sigmoid=use_sigmoid,
            )
            for r in tqdm(records, desc=f"{name}/neg")
        ],
        dtype=np.float64,
    )

    rows: list[dict] = []
    for spec in HIDDEN_SUITE_ATTACKS:
        psnr_vals, bit_vals, pos_scores = [], [], []
        if spec.name in noise_registry:
            layers = noise_registry[spec.name]
            for rec in tqdm(records, desc=f"{name}/{spec.name}", unit="img", leave=False):
                atk_t = apply_hidden_attack(layers, rec["wm_t"], rec["host_t"])
                attacked_pil = tensor_to_pil(atk_t)
                psnr_vals.append(psnr_pil(rec["host_pil"], attacked_pil))
                out = decode_fn(model, atk_t)
                ref_bits = rec["ref_bits"]
                bit_vals.append(bit_acc(ref_bits, bits_from_output(out, use_sigmoid=use_sigmoid)))
                pos_scores.append(detection_score(out, ref_bits, use_sigmoid=use_sigmoid))
        else:
            for i, rec in enumerate(tqdm(records, desc=f"{name}/{spec.name}", unit="img", leave=False)):
                attacked_pil = apply_attack_rgb(spec.name, rec["wm_pil"], seed=i)
                psnr_vals.append(psnr_pil(rec["host_pil"], attacked_pil))
                atk_t = pil_to_tensor(attacked_pil, device)
                out = decode_fn(model, atk_t)
                ref_bits = rec["ref_bits"]
                bit_vals.append(bit_acc(ref_bits, bits_from_output(out, use_sigmoid=use_sigmoid)))
                pos_scores.append(detection_score(out, ref_bits, use_sigmoid=use_sigmoid))

        rows.append(_attack_row(name, spec, len(records), psnr_vals, bit_vals, pos_scores, neg_scores))
    return rows


def _attack_row(
    name: str,
    spec: AttackSpec,
    n_images: int,
    psnr_vals: list[float],
    bit_vals: list[float],
    pos_scores: list[float],
    neg_scores: np.ndarray,
) -> dict:
    pos_arr = np.asarray(pos_scores, dtype=np.float64)
    auroc, tpr1 = auroc_tpr(pos_arr, neg_scores)
    row = {
        "method": name,
        "attack": spec.name,
        "description": spec.description,
        "n_images": n_images,
        "PSNR_mean": float(np.mean(psnr_vals)),
        "PSNR_median": float(np.median(psnr_vals)),
        "bit_accuracy": float(np.mean(bit_vals)),
        "AUROC": auroc,
        "TPR_at_1pct_FPR": tpr1,
    }
    print(
        f"  {spec.name:20s}: PSNR={row['PSNR_median']:.1f} "
        f"BitAcc={row['bit_accuracy']:.3f} "
        f"BER={(1-row['bit_accuracy'])*100:.2f}% "
        f"AUROC={row['AUROC']:.3f} "
        f"TPR@1%={row['TPR_at_1pct_FPR']:.3f}",
        flush=True,
    )
    return row


def write_csv(path: Path, rows: list[dict]) -> None:
    if not rows:
        return
    with open(path, "w", newline="", encoding="utf-8") as f:
        w = csv.DictWriter(f, fieldnames=list(rows[0].keys()))
        w.writeheader()
        w.writerows(rows)
    print(f"  → {path}")


def _print_win_loss(rows: list[dict]) -> None:
    hidden_rows = [r for r in rows if r["method"].startswith("HiDDeN")]
    moe_rows = {r["attack"]: r for r in rows if r["method"].startswith("MoE")}
    wins = losses = ties = 0
    print(f"\n{'Attack':<12} {'HiDDeN BER':>11} {'MoE BER':>11} {'Δ BitAcc':>10}")
    print("-" * 48)
    for h in hidden_rows:
        m = moe_rows.get(h["attack"])
        if not m:
            continue
        h_ber = (1.0 - h["bit_accuracy"]) * 100.0
        m_ber = (1.0 - m["bit_accuracy"]) * 100.0
        delta = m["bit_accuracy"] - h["bit_accuracy"]
        if delta > 0.0005:
            wins += 1
        elif delta < -0.0005:
            losses += 1
        else:
            ties += 1
        print(f"{h['attack']:<12} {h_ber:>10.2f}% {m_ber:>10.2f}% {delta:>+10.3f}")
    print(f"\nMoE wins: {wins}  |  HiDDeN wins: {losses}  |  ties: {ties}")


def main() -> int:
    p = argparse.ArgumentParser(description="HiDDeN + MoE benchmark (WAVES or HiDDeN noise_layers)")
    p.add_argument(
        "--attack-suite",
        choices=("waves", "hidden"),
        default="waves",
        help="waves=PIL benchmark_attacks (14); hidden=noise_layers (9) + 5 WAVES extras",
    )
    p.add_argument("--images", type=Path, default=REPO_ROOT / "data" / "coco100k" / "val")
    p.add_argument("--n-images", type=int, default=100)
    p.add_argument("--output", type=Path, default=REPO_ROOT / "results" / "benchmark")
    p.add_argument("--device", default="cuda" if torch.cuda.is_available() else "cpu")
    p.add_argument("--hidden-run", type=Path, default=DEFAULT_HIDDEN_RUN)
    p.add_argument("--hidden-ckpt", type=Path, default=DEFAULT_HIDDEN_CKPT)
    p.add_argument("--moe-run", type=Path, default=DEFAULT_MOE_RUN)
    p.add_argument("--moe-ckpt", type=Path, default=DEFAULT_MOE_CKPT)
    p.add_argument("--skip-hidden", action="store_true")
    p.add_argument("--skip-moe", action="store_true")
    args = p.parse_args()

    device = torch.device(args.device)
    args.output.mkdir(parents=True, exist_ok=True)
    images = list_images(args.images, args.n_images)
    suite = args.attack_suite
    if suite == "hidden":
        args.output = args.output if args.output != REPO_ROOT / "results" / "benchmark" else REPO_ROOT / "results" / "benchmark_hidden"
    print(f"Repo: {REPO_ROOT}")
    print(f"Attack suite: {suite}  |  Device: {device}  |  Images: {len(images)}  |  Output: {args.output}")

    noise_registry = hidden_noise_registry(device) if suite == "hidden" else None
    benchmark_fn = benchmark_model_hidden if suite == "hidden" else benchmark_model_waves

    all_rows: list[dict] = []

    if not args.skip_hidden:
        print("\n=== HiDDeN ep177 ===")
        hidden_model, hidden_cfg = load_hidden(args.hidden_ckpt, args.hidden_run, device)
        kw = dict(
            name="HiDDeN-ep177",
            model=hidden_model,
            decode_fn=decode_hidden,
            use_sigmoid=False,
            images=images,
            device=device,
            msg_len=hidden_cfg.message_length,
        )
        if suite == "hidden":
            kw["noise_registry"] = noise_registry
        rows_h = benchmark_fn(**kw)
        all_rows.extend(rows_h)
        write_csv(args.output / "results_hidden.csv", rows_h)
        del hidden_model
        if device.type == "cuda":
            torch.cuda.empty_cache()

    if not args.skip_moe:
        print("\n=== MoE R0 ep20 (soft router) ===")
        moe_model, moe_cfg = load_moe(args.moe_ckpt, args.moe_run, device)
        kw = dict(
            name="MoE-R0-soft",
            model=moe_model,
            decode_fn=decode_moe,
            use_sigmoid=False,
            images=images,
            device=device,
            msg_len=moe_cfg.message_length,
        )
        if suite == "hidden":
            kw["noise_registry"] = noise_registry
        rows_m = benchmark_fn(**kw)
        all_rows.extend(rows_m)
        write_csv(args.output / "results_moe.csv", rows_m)
        del moe_model
        if device.type == "cuda":
            torch.cuda.empty_cache()

    if all_rows:
        write_csv(args.output / "results_combined.csv", all_rows)
        with open(args.output / "results.json", "w", encoding="utf-8") as f:
            json.dump(
                {"attack_suite": suite, "n_images": len(images), "attacks": all_rows},
                f,
                indent=2,
            )

    if suite == "hidden" and all_rows:
        _print_win_loss(all_rows)
    else:
        key = {"identity", "jpeg_q50", "crop", "gaussian", "combined"}
        print(f"\n{'Attack':<22} {'Method':<18} {'PSNR':>6} {'BitAcc':>7} {'AUROC':>7} {'TPR@1%':>7}")
        print("-" * 72)
        for row in all_rows:
            if row["attack"] in key:
                print(
                    f"{row['attack']:<22} {row['method']:<18} "
                    f"{row['PSNR_median']:>6.1f} {row['bit_accuracy']:>7.3f} "
                    f"{row['AUROC']:>7.3f} {row['TPR_at_1pct_FPR']:>7.3f}"
                )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
