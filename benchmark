@dataclass(frozen=True)
class AttackSpec:
    name: str
    description: str


HIDDEN_ATTACKS: tuple[AttackSpec, ...] = (
    AttackSpec("identity", "no distortion"),
    AttackSpec("jpeg", "differentiable JPEG (DCT keep 25/9/9)"),
    AttackSpec("quant", "8-bit Fourier quantization"),
    AttackSpec("crop", "random crop keep 55-60% H/W, bilinear resize back"),
    AttackSpec("cropout", "random 55-60% patch from wm, rest from cover"),
    AttackSpec("dropout", "random pixel dropout 55-60% keep, rest from cover"),
    AttackSpec("resize", "random scale 0.5-1.1, nearest, bilinear back"),
    AttackSpec("gaussian", "additive Gaussian sigma 0.01-0.05 on [-1,1]"),
    AttackSpec(
        "combined",
        "resize -> jpeg -> crop -> dropout -> gaussian (HiDDeN chain)",
    ),
)

# WAVES PIL attacks not covered by HiDDeN noise_layers (benchmark_attacks.py strengths).
WAVES_EXTRA_ATTACK_NAMES: tuple[str, ...] = (
    "rotation",
    "resized_crop",
    "erasing",
    "brightness",
    "contrast",
)
_waves_by_name = {a.name: a for a in WAVES_ATTACKS}
WAVES_EXTRA_ATTACKS: tuple[AttackSpec, ...] = tuple(
    AttackSpec(_waves_by_name[n].name, _waves_by_name[n].description) for n in WAVES_EXTRA_ATTACK_NAMES
)
HIDDEN_SUITE_ATTACKS: tuple[AttackSpec, ...] = HIDDEN_ATTACKS + WAVES_EXTRA_ATTACKS

DEFAULT_HIDDEN_RUN = REPO_ROOT / "hidden" / "runs" / "my_hidden_experiment 2026.05.17--21-47-43"
DEFAULT_HIDDEN_CKPT = REPO_ROOT / "hiddenepcoh177" / "my_hidden_experiment--epoch-177.pyt"
